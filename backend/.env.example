PORT=3001
# Comma-separated if you have multiple frontends (local + Vercel)
FRONTEND_URL=http://localhost:3000,https://clairedelune.vercel.app

# Neon PostgreSQL (production + local)
# DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Roles are moon | sun via header x-author (no ADMIN_PASSWORD / READER_TOKEN)
# Railway/Vercel: NO quotes around values, NO trailing slash on URLs

# Web Push (generate via: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
